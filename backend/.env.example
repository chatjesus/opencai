# Copy this file to .env and fill in your values.
# The backend will auto-load .env on startup (via python-dotenv).

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to ./clawfans.db (SQLite) when not set.
# DATABASE_URL=sqlite:///./clawfans.db

# ── LLM Provider (Text) ──────────────────────────────────────────────────────
# Supported values: ollama (default, local) | xai (opt-in cloud via official api.x.ai)
LLM_PROVIDER=ollama

# Local Ollama settings (used when LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
# opencai is an UNCENSORED adult product. Standard/aligned models (qwen2.5,
# qwen3, llama, etc.) refuse or empty out on explicit content — use an
# ABLITERATED (uncensored) model, or NSFW roleplay will not work.
#   ollama pull huihui_ai/qwen2.5-abliterate:14b
OLLAMA_MODEL=huihui_ai/qwen2.5-abliterate:14b
OLLAMA_NUM_CTX=8192

# Opt-in xAI settings (used only when LLM_PROVIDER=xai):
XAI_API_KEY=
XAI_MODEL=grok-4.3
# Private-beta output token cap (max 1200):
XAI_MAX_TOKENS=600

# ── Image Generation Provider ────────────────────────────────────────────────
# Supported values: auto (default: local ComfyUI -> Gemini) | comfyui | gemini | xai | none
IMAGE_PROVIDER=auto

# ComfyUI local image generation (default local path):
COMFYUI_URL=http://127.0.0.1:8188

# Opt-in xAI Grok Imagine (used only when IMAGE_PROVIDER=xai, explicit button trigger only):
# Optional scoped key override for images; falls back to XAI_API_KEY when blank.
XAI_IMAGE_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# ── Authentication (Web Clerk + Operator Admin) ──────────────────────────────
# Optional for local dev; set in shared deployments.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Pin the expected Clerk instance and browser origin when deploying.
CLERK_JWT_ISSUER=
CLERK_AUTHORIZED_PARTIES=
# Comma-separated Clerk user IDs for the hosted beta.
OPENCAI_ALLOWED_CLERK_USER_IDS=
# Either xAI provider also enables invite-only mode automatically.
OPENCAI_PRIVATE_BETA=false
# Required to unlock admin endpoints (/api/admin/* and Telegram settings mutations):
OPS_ADMIN_TOKEN=

# ── Telegram Bot & Mini App (WebApp) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Opt-in Telegram Mini App initData verification:
TELEGRAM_WEBAPP_ENABLED=false
# HTTPS URL opened by your Telegram Bot Menu Button (configure via @BotFather /setmenubutton):
TELEGRAM_WEBAPP_URL=https://your-domain.example.com
# Freshness window in seconds for signed Telegram initData.auth_date:
TELEGRAM_WEBAPP_MAX_AGE_SECONDS=900
# Private tester allowlist (comma-separated numeric Telegram user IDs):
TELEGRAM_WEBAPP_ALLOWLIST_REQUIRED=true
TELEGRAM_ALLOWED_USER_IDS=
# Optional dedicated signing secret for Mini App session tokens (derives from bot token if blank):
WEBAPP_SESSION_SECRET=
# Optional explicit Telegram->Web user mapping (e.g. 12345678:user_2abcXYZ):
TELEGRAM_USER_LINKS=

# ── Cloudflare R2 Image Storage (optional) ───────────────────────────────────
# If not set, images are served from local disk (backend/uploads/).
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=clawfans
R2_PUBLIC_URL=https://your-domain.dev

# ── Voice / TTS ──────────────────────────────────────────────────────────────
# Engine order: local GPT-SoVITS (:9880) → edge-tts (needs ALLOW_ONLINE_MODELS=1).
TTS_ENGINE=
MIMO_API_KEY=
MIMO_VOICE=mimo_default

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
# Comma-separated list of browser origins allowed by CORS.
# ALLOWED_ORIGINS=https://opencai.example.com
